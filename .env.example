# ---------------------------------------------------------------------------
# Web app (Next.js) — these are read at build/run time.
# Copy to .env.local and fill in from your Supabase project settings.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Ingestion scripts (Python, ingest/) — these need elevated access to upsert
# reference data and upload headshots. Keep the service role key server-side
# only; never expose it to the browser.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket name for mirrored headshots (created by the migration).
SUPABASE_HEADSHOT_BUCKET=headshots

# A real User-Agent for Basketball Reference scraping (they rate limit hard).
BBREF_USER_AGENT=big-board-redraft/0.1 (personal research tool)

# ---------------------------------------------------------------------------
# TMN Aggregator (the owner-only /news section) — server-side only.
# Reuses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above for DB access.
# ---------------------------------------------------------------------------

# Gate for the /news surface. Only this signed-in email sees + controls it.
OWNER_EMAIL=you@example.com

# Claude — scoring (Haiku), drafting (Sonnet), verification (Haiku).
ANTHROPIC_API_KEY=sk-ant-...

# X / Twitter API v2 (OAuth 1.0a user context). Publishing stays queued-only
# until all four are present.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Shared secret for the Vercel cron route. Vercel attaches it as
# `Authorization: Bearer <CRON_SECRET>` automatically; the route rejects
# anything else, so the pipeline never runs without it set.
CRON_SECRET=
